# Only what the image needs. Everything else (tests, docs, local builds,
# node_modules, .env files) stays out of the build.
**
!client/package.json
!client/package-lock.json
!client/index.html
!client/tsconfig.json
!client/vite.config.ts
!client/src/**
!server/package.json
!server/package-lock.json
!server/src/**
